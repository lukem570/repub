#!/bin/sh
#
# Commit message hook for Repub
# Validates commit message format

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Check minimum length
if [ ${#commit_msg} -lt 10 ]; then
    echo "Error: Commit message is too short (minimum 10 characters)"
    exit 1
fi

# Check first line length
first_line=$(echo "$commit_msg" | head -n1)
if [ ${#first_line} -gt 72 ]; then
    echo "Warning: First line of commit message is longer than 72 characters"
    # Not failing, just warning
fi

# Check for imperative mood (simple check - starts with capital letter)
first_char=$(echo "$first_line" | cut -c1)
if ! echo "$first_char" | grep -q '[A-Z]'; then
    echo "Warning: Commit message should start with a capital letter"
fi

exit 0
